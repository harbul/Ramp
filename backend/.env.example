# Ramp backend configuration — AWS-backed (recommended).
#
# Copy this file to backend/.env and fill in your values:
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored — never commit real credentials or resource
# names. config.py loads this file automatically via python-dotenv when you
# run uvicorn from backend/; in Lambda these same names come from the
# function's environment instead.
#
# To run fully offline instead (no AWS account needed), see the "Offline
# mode" section of Docs/QUICKSTART.md — it's the four PDF_* provider lines
# below, each set to their local/stub value.

# ── Storage & job persistence ──────────────────────────────────────────
# local | s3          (local = ./work on disk; s3 = the bucket below)
PDF_STORAGE_BACKEND=s3
# json | dynamo        (json = ./work/state on disk; dynamo = the table below)
PDF_JOB_STORE=dynamo

PDF_S3_BUCKET=ramp-pdfs-prod
PDF_DDB_TABLE=ramp-jobs-prod

# ── AI providers ────────────────────────────────────────────────────────
# stub | bedrock        (stub = deterministic fake text, no AWS call)
PDF_ALT_TEXT_PROVIDER=bedrock
# none | stub | textract | bedrock_vision
PDF_OCR_PROVIDER=textract
# none | onnx_yolo      (improves OCR figure bounding boxes; optional)
PDF_LAYOUT_DETECTOR=none

# Claude vision on Bedrock, cross-region inference profile (the "us." prefix
# is required — the bare model id is rejected by the inference API).
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-8
# Only used if PDF_OCR_PROVIDER=bedrock_vision; defaults to a Haiku profile.
BEDROCK_OCR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ── AWS ─────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
# Named profile from ~/.aws/config, if you use SSO / multiple accounts.
# Leave unset to use the default credential chain (env vars, instance role, etc).
AWS_PROFILE=

# ── Optional: remediate a listed corpus form without re-uploading it ─────
# Leave PDF_CORPUS_BUCKET unset to disable this feature (safe no-op, 404s cleanly).
PDF_CORPUS_BUCKET=
PDF_CORPUS_PREFIX=data/campus-forms

# ── Local scratch space (used for temp files regardless of backend) ──────
PDF_WORK_DIR=./work
